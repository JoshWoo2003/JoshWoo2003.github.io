@inproceedings{lan2027zenflow,
  abbr={SIGMOD’27},
  title={ZenFlow: Enabling Stall-Free Offloading for LLM Training},
  author={Lan, Tingfeng and Wu, Yusen and Ma, Bin and Su, Zhaoyuan and Yang, Rui and Bicer, Tekin and Tanaka, Masahiro and Ruwase, Olatunji and Li, Dong and Cheng, Yue},
  booktitle={ACM SIGMOD International Conference on Management of Data (SIGMOD)},
  year={2027},
  note={To appear},
  arxiv={2505.12242},
  blog={https://pytorch.org/blog/zenflow-stall-free-offloading-engine-for-llm-training/},
  code={https://github.com/deepspeedai/DeepSpeed/tree/master/deepspeed/runtime/zenflow},
  abstract={Fine-tuning large language models (LLMs) often exceeds GPU memory limits, prompting systems to offload model states to CPU memory. However, existing offloaded training frameworks like ZeRO-Offload treat all parameters equally and update the full model on the CPU, causing severe GPU stalls, where fast, expensive GPUs sit idle, waiting for slow CPU updates and limited-bandwidth PCIe transfers. We present ZenFlow, a new offloaded training framework that decouples updates between GPU and CPU by prioritizing important gradients. ZenFlow performs in-place updates of important gradients on GPU while offloading and accumulating less important ones on CPU without blocking training iterations, fully overlapping CPU work with GPU computation. To make this importance-aware design scalable, ZenFlow leverages a novel spatio-temporal locality of important gradients, concentrated in specific positions that remain stable across iterations, to make important gradient identification efficient and lightweight while preserving fidelity. Evaluation shows that ZenFlow achieves up to 5x end-to-end speedup, 2x lower PCIe traffic, 85\% less GPU stalls, and up to 72\% lower cloud GPU cost, all while preserving accuracy.},
  bibtex_show={true},
  selected={true}
}

@article{wu2026looseleaf,
  abbr={Preprint},
  title={LooseLeaf: Enabling Serverless GPUs for Computational Notebooks},
  author={Wu, Yusen and Lan, Tingfeng and Carver, Benjamin and Wang, Haoliang and Fox, Geoffrey and Cheng, Yue},
  journal={arXiv preprint arXiv:2610.33275},
  year={2026},
  arxiv={2610.33275},
  website={https://looseleafcloud.org},
  abstract={Computational notebooks reserve a GPU for the whole session, yet the GPU computes only while a cell executes and sits idle otherwise. Serverless execution would release the GPU between cells, but reconstructing the accumulated notebook state on a fresh worker imposes substantial cost on every GPU cell. This paper presents LooseLeaf, a serverless GPU platform for interactive notebooks. LooseLeaf derives the state and import closures of each cell, the minimal variables and packages that the cell needs. Our analysis on 5,000 real-world notebooks shows that these closures are small, and user-cell editing leaves seconds to prepare them. LooseLeaf prepares a GPU worker with these closures while the user edits the cell. After execution, the worker saves the updated state within seconds, so the GPU is reclaimable after every cell. LooseLeaf starts 95-98\% of GPU cells with no visible delay, matches the interactivity of a pinned session, and provisions 32-55\% fewer GPU-hours than state-of-the-art notebook platforms.},
  bibtex_show={true},
  selected={true}
}
